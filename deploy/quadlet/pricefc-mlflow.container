[Unit]
Description=pricefc @ENV@ MLflow tracking server and model registry

[Container]
Image=localhost/pricefc:current
Pod=pricefc.pod
ContainerName=pricefc-mlflow
Volume=%h/pricefc/mlflow:/data/mlflow
# MLflow 3 starts a GenAI job runner + 7 queue consumers (~240 MB each) by default; unused here.
Environment=MLFLOW_SERVER_ENABLE_JOB_EXECUTION=false
Exec=mlflow server --backend-store-uri sqlite:////data/mlflow/mlflow.db --artifacts-destination /data/mlflow/artifacts --host 0.0.0.0 --port 5000 --workers 1
HealthCmd=curl -fsS http://localhost:5000/health
HealthInterval=60s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
