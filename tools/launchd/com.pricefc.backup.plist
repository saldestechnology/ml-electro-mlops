<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily pull backup of the VPS (tools/backup_vps.sh). macOS denies launchd jobs access to
     ~/Documents, so the job runs an installed copy (re-run the install after changing it):
       install -d ~/.local/libexec && install -m 755 tools/backup_vps.sh ~/.local/libexec/pricefc-backup.sh
       sed "s|@HOME@|$HOME|g" tools/launchd/com.pricefc.backup.plist \
         > ~/Library/LaunchAgents/com.pricefc.backup.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pricefc.backup.plist
     launchd runs a missed 03:30 slot when the Mac wakes. Log: ~/Backups/pricefc/backup.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pricefc.backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>@HOME@/.local/libexec/pricefc-backup.sh</string><string>staging</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>@HOME@/Backups/pricefc/backup.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Backups/pricefc/backup.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
